 "spec": {
  "title": "장난감 FIFO 명세",
  "clauses": [
   {
    "id": "S1",
    "rule": "capacity",
    "depth": 4,
    "text": "FIFO는 최대 4개를 담는다. 4개일 때의 push는 거부된다."
   },
   {
    "id": "S2",
    "rule": "order",
    "text": "비어 있지 않을 때의 pop은 가장 오래된 값을 돌려준다."
   },
   {
    "id": "S3",
    "rule": "underflow",
    "text": "비어 있을 때의 pop은 처리되지 않고 값을 돌려주지 않는다."
   },
   {
    "id": "S4",
    "rule": "count",
    "text": "매 연산 뒤 count는 담긴 개수와 같다."
   },
   {
    "id": "S5",
    "rule": "flags",
    "text": "full과 empty 플래그는 담긴 개수와 맞아야 한다."
   }
  ]
 },
