{
 "fixture_version": 1,
 "label": "Edge cases (synthetic): single hops, tolerance edges, equal magnitude, negative zero, extremes",
 "cases": [
  {"id": "single_clean", "label": "one agent, no fault", "start": 1, "tolerance": 0.1,
   "hops": [{"agent": "solo", "op": "mul", "arg": 3}],
   "expect": {"outcome": "PASS", "trace": "clean", "hops": ["clean"]}},
  {"id": "single_fault", "label": "one agent, a fault above tolerance", "start": 1, "tolerance": 0.1,
   "hops": [{"agent": "solo", "op": "mul", "arg": 3, "fault": -0.2}],
   "expect": {"outcome": "FAIL", "trace": "reached_end", "hops": ["introduced"]}},
  {"id": "fault_on_tolerance", "label": "a fault exactly equal to the tolerance is within it", "start": 2, "tolerance": 0.25,
   "hops": [{"agent": "first", "op": "add", "arg": 1, "fault": 0.25},
            {"agent": "second", "op": "add", "arg": 1}],
   "expect": {"outcome": "PASS", "trace": "clean", "hops": ["clean", "clean"]}},
  {"id": "fault_just_over", "label": "a fault one step above the tolerance", "start": 2, "tolerance": 0.25,
   "hops": [{"agent": "first", "op": "add", "arg": 1, "fault": 0.250000000001},
            {"agent": "second", "op": "add", "arg": 1}],
   "expect": {"outcome": "FAIL", "trace": "reached_end", "hops": ["introduced", "amplified"]}},
  {"id": "attenuated_not_enough", "label": "halved twice but still above tolerance at the end", "start": 4, "tolerance": 0.5,
   "hops": [{"agent": "first", "op": "add", "arg": 0, "fault": 4},
            {"agent": "second", "op": "mul", "arg": 0.5},
            {"agent": "third", "op": "mul", "arg": 0.5}],
   "expect": {"outcome": "FAIL", "trace": "reached_end", "hops": ["introduced", "attenuated", "attenuated"]}},
  {"id": "attenuated_to_pass", "label": "halved until within tolerance, with no recheck", "start": 4, "tolerance": 0.5,
   "hops": [{"agent": "first", "op": "add", "arg": 0, "fault": 2},
            {"agent": "second", "op": "mul", "arg": 0.5},
            {"agent": "third", "op": "mul", "arg": 0.5}],
   "expect": {"outcome": "PASS", "trace": "corrected", "hops": ["introduced", "attenuated", "corrected"]}},
  {"id": "corrected_then_again", "label": "corrected, then a new fault at the last hop", "start": 0, "tolerance": 0.5,
   "hops": [{"agent": "first", "op": "add", "arg": 1, "fault": 1},
            {"agent": "second", "op": "add", "arg": 1, "recheck": true},
            {"agent": "third", "op": "add", "arg": 1, "fault": -3}],
   "expect": {"outcome": "FAIL", "trace": "reached_end", "hops": ["introduced", "corrected", "introduced"]}},
  {"id": "negative_zero", "label": "a start of -0 and a computed zero from a negative value", "start": -0.0, "tolerance": 0.5,
   "hops": [{"agent": "first", "op": "add", "arg": -3},
            {"agent": "second", "op": "mul", "arg": 0}],
   "expect": {"outcome": "PASS", "trace": "clean", "hops": ["clean", "clean"]}},
  {"id": "extremes", "label": "values at the input cap and a tiny fault", "start": 1000000, "tolerance": 0.000000000001,
   "hops": [{"agent": "first", "op": "mul", "arg": 1000000},
            {"agent": "second", "op": "add", "arg": -1000000, "fault": 0.000000000002}],
   "expect": {"outcome": "FAIL", "trace": "reached_end", "hops": ["clean", "introduced"]}},
  {"id": "sign_flip", "label": "a negative fault flipped by a negative multiplier retains its size", "start": 1, "tolerance": 0.1,
   "hops": [{"agent": "first", "op": "add", "arg": 1, "fault": -1},
            {"agent": "second", "op": "mul", "arg": -1}],
   "expect": {"outcome": "FAIL", "trace": "reached_end", "hops": ["introduced", "amplified"]}}
 ]
}
